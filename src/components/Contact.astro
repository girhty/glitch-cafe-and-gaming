---
const address = "شارع الصالحية, Baghdad, Baghdad Governorate";
const phone = "0775 574 6023";
const openNow = true;
---
<section id="contact" class="py-20 bg-glitch-darker" aria-label="Contact Information">
  <div class="container mx-auto px-4">
    <div class="bg-gradient-to-br from-white/5 to-transparent border border-white/10 rounded-3xl overflow-hidden shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        
        <div class="p-10 md:p-14 flex flex-col justify-center">
          <h2 class="text-3xl md:text-4xl font-bold mb-8 text-white">زورونا اليوم وخلي <span class="text-glitch-neon">الونسة تبدأ</span></h2>
          
          <div class="space-y-6 mb-10">
            <div class="flex items-start gap-4">
              <div class="bg-glitch-purple/20 p-3 rounded-full text-glitch-neon">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">العنوان</h3>
                <p class="text-gray-400">{address}<br/>سنتر الصالحية - الطابق الأول / الثاني حسب القسم</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="bg-glitch-purple/20 p-3 rounded-full text-glitch-neon">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">الهاتف</h3>
                <p class="text-gray-400" dir="ltr"><a href={`tel:${phone.replace(/\s/g, '')}`} class="hover:text-glitch-neon transition">{phone}</a></p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="bg-green-500/20 p-3 rounded-full text-green-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">ساعات العمل</h3>
                <p class="text-green-400 font-bold flex items-center gap-2">
                  {openNow ? 'مفتوح الآن' : 'مغلق حالياً'}
                  <span class="relative flex h-3 w-3">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                  </span>
                </p>
              </div>
            </div>
          </div>
          
          <a href={`tel:${phone.replace(/\s/g, '')}`} class="inline-block bg-white text-black font-black px-8 py-4 rounded-full hover:bg-glitch-neon hover:text-white transition text-center text-lg shadow-lg">
            احجز طاولتك أو غرفة VIP
          </a>
        </div>
        
        <div class="h-80 lg:h-auto w-full relative bg-black">
          <iframe 
            src="https://maps.google.com/maps?q=%D8%B4%D8%A7%D8%B1%D8%B9%20%D8%A7%D9%84%D8%B5%D8%A7%D9%84%D8%AD%D9%8A%D8%A9%20Baghdad&t=&z=15&ie=UTF8&iwloc=&output=embed"
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Map to Glitch Cafe"
            class="absolute inset-0"></iframe>
        </div>

      </div>
    </div>
  </div>
</section>