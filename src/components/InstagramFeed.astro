---
<section id="instagram" class="py-20 bg-glitch-darker" aria-label="Instagram Feed">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between items-center mb-12 gap-6">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold mb-2">تابعونا على إنستغرام</h2>
        <p class="text-gray-400">آخر الفعاليات، البطولات، والأجواء الحلوة.</p>
      </div>
      <div class="flex items-center gap-4 bg-gradient-to-r from-purple-900/40 to-pink-900/40 border border-pink-500/30 px-6 py-3 rounded-full backdrop-blur-sm">
        <div>
          <p class="font-bold text-pink-400">@{handle}</p>
          <p class="text-xs text-gray-300">{followers} متابع</p>
        </div>
        <a href={`https://instagram.com/${handle}`} target="_blank" rel="noopener" class="bg-pink-600 hover:bg-pink-500 text-white px-4 py-2 rounded-full text-sm font-bold transition">
          تابعنا
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
      {posts.map(post => (
        <article class="group relative bg-black rounded-2xl overflow-hidden border border-white/10 hover:border-pink-500/50 transition shadow-lg">
          <div class="aspect-square overflow-hidden">
            <img src={post.image} alt="Instagram Post" class="w-full h-full object-cover group-hover:scale-110 transition duration-500 opacity-80 group-hover:opacity-100" loading="lazy"/>
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent opacity-0 group-hover:opacity-100 transition duration-300 flex flex-col justify-end p-4">
            <p class="text-xs text-gray-200 line-clamp-4 mb-2">{post.caption}</p>
            <div class="flex items-center gap-2 text-pink-500 text-sm font-bold">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              <span>{post.likes}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>