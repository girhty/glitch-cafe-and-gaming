---
const bgImage = "https://lh3.googleusercontent.com/grass-cs/ACvplmOBwYioaTWiWAeUSDDPgHOMudesanD1EUre2gLJUS190AC7p15PyBga7t4l_RfldP6bS5LsXG5gA6FUl1y1l3JQSc1_qNT1AejXx4NClwbkOierMAhPgE_6aEO-GsstoZ3C8CsBLfrecck=w408-h306-k-no";
---
<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden pt-20 pb-16" aria-label="Hero Section">
  <div class="absolute inset-0 z-0">
    <img src={bgImage} alt="Glitch Cafe Background" class="w-full h-full object-cover opacity-30" />
    <div class="absolute inset-0 bg-gradient-to-b from-glitch-darker via-glitch-dark/80 to-glitch-darker"></div>
  </div>
  
  <div class="container mx-auto px-4 z-10 text-center flex flex-col items-center">
    <div class="inline-flex items-center gap-2 bg-black/50 border border-glitch-purple/30 rounded-full px-4 py-1.5 mb-6 backdrop-blur-sm">
      <span class="text-yellow-400">⭐</span>
      <span class="text-sm font-bold">5.0 على Google Reviews</span>
      <span class="text-gray-400 text-xs">(2 تقييم)</span>
    </div>
    
    <h1 class="text-5xl md:text-7xl font-black tracking-tight mb-6 leading-tight">
      <span class="block text-transparent bg-clip-text bg-gradient-to-r from-glitch-purple via-glitch-neon to-glitch-purple">GLITCH</span>
      <span class="block mt-2 text-white">كافيه وقيمنق مجمع الصالحية</span>
    </h1>
    
    <p class="max-w-2xl mx-auto text-lg md:text-xl text-gray-300 mb-10 leading-relaxed">
      أحدث أجهزة PlayStation 5 و PC Gaming، طاولات بليارد احترافية، غرف VIP، وألعاب بورد مع أفضل مشروبات القهوة المختصة. المكان المثالي للمة الربع والتحدي!
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="tel:07755746023" class="bg-gradient-to-r from-glitch-purple to-indigo-600 hover:from-indigo-500 hover:to-glitch-neon text-white font-bold py-4 px-8 rounded-full shadow-lg shadow-glitch-purple/30 transition transform hover:-translate-y-1 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
        </svg>
        اتصل واحجز الآن: 0775 574 6023
      </a>
      <a href="#instagram" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold py-4 px-8 rounded-full transition backdrop-blur-sm">
        شوف الأجواء
      </a>
    </div>
  </div>
</section>